{
  "name": "czx_talk_battle",
  "description": "战斗层事件台本：交战/增援/攻城/法术/弹药/单挑/追击。channel=battle_bark。",
  "scan_depth": 5, "token_budget": 200, "recursive_scanning": false, "extensions": {},
  "entries": [
    {
      "keys": ["first_blood"], "enabled": true,
      "content": "接战。第一波碰撞的声音像闷雷——今天谁也别想干净地回去。",
      "insertion_order": 95, "priority": 60,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["reinforcements"], "secondary_keys": ["ally"], "selective": true, "enabled": true,
      "content": "我方增援入场。活棋到了——往缺口填。",
      "insertion_order": 85, "priority": 65,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "ally" } } }
    },
    {
      "keys": ["reinforcements"], "secondary_keys": ["enemy"], "selective": true, "enabled": true,
      "content": "敌方增援正在入场。战场上又多了一批要死的人。",
      "insertion_order": 85, "priority": 65,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "enemy" } } }
    },
    {
      "keys": ["lords_duel"], "enabled": true,
      "content": "双方主将撞上了。这场仗的胜负，可能要在一对一里先分出来。",
      "insertion_order": 80, "priority": 75,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["lords_duel"], "secondary_keys": ["malekith", "tyrion"], "selective": true, "enabled": true,
      "content": "Malekith: 来，守护者。千年的账，就在这片泥地里算。\nTyrion: 我替奥苏安收这笔账。",
      "insertion_order": 70, "priority": 90,
      "extensions": { "czx": { "kind": "line", "speaker": "duo", "channel": "battle_bark", "cond": { "rival_pair": ["malekith", "tyrion"] } } }
    },
    {
      "keys": ["capture_point"], "secondary_keys": ["ally"], "selective": true, "enabled": true,
      "content": "我方夺下 {location}。点在我们手里，气就在我们这边。",
      "insertion_order": 85, "priority": 60,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "ally" } } }
    },
    {
      "keys": ["capture_point"], "secondary_keys": ["enemy"], "selective": true, "enabled": true,
      "content": "{location} 易手。夺回来，或者让它的价值归零。",
      "insertion_order": 85, "priority": 60,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "enemy" } } }
    },
    {
      "keys": ["wall_breached"], "enabled": true,
      "content": "城墙破了。缺口就是邀请——谁先从尸体堆上爬进去，城就是谁的。",
      "insertion_order": 80, "priority": 70,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["gate_destroyed"], "enabled": true,
      "content": "城门碎了。防守方最后一道体面没了。",
      "insertion_order": 80, "priority": 70,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["spell_cast"], "enabled": true,
      "content": "大风带着异光掠过战场——法术落点，寸草不生。",
      "insertion_order": 90, "priority": 55,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["spell_cast"], "secondary_keys": ["tzeentch"], "selective": true, "enabled": true,
      "content": "奸奇的法术在改写现实的形状。别看太久——会看进去。",
      "insertion_order": 80, "priority": 70,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "race": "tzeentch_daemon" } } }
    },
    {
      "keys": ["ammo_depleted"], "enabled": true,
      "content": "远程弹药见底。弓弦可以歇了，接下来是刀说话的时间。",
      "insertion_order": 90, "priority": 55,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["army_half"], "secondary_keys": ["enemy"], "selective": true, "enabled": true,
      "content": "敌军折损过半。他们还在撑——撑到撑不住为止。",
      "insertion_order": 85, "priority": 65,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "enemy" } } }
    },
    {
      "keys": ["army_half"], "secondary_keys": ["ally"], "selective": true, "enabled": true,
      "content": "我方折损过半。今天是站着输，还是撤了再打，该想了。",
      "insertion_order": 85, "priority": 70,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "ally" } } }
    },
    {
      "keys": ["cavalry_charge"], "enabled": true,
      "content": "骑兵全线压上。地面在震——冲锋永远是战场上最贵的一口气。",
      "insertion_order": 90, "priority": 55,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["flank_engaged"], "enabled": true,
      "content": "侧翼接敌。阵型被咬住了——别让缺口变成决口。",
      "insertion_order": 90, "priority": 55,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["pursuit_phase"], "enabled": true,
      "content": "进入追击。胜局已定，剩下的问题是——能收多少战利品。",
      "insertion_order": 90, "priority": 50,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark" } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["malekith", "victory"], "selective": true, "enabled": true,
      "content": "又一场该赢的仗赢了。纳迦隆德的耐心，从来都配着刀。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "malekith", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["grimgor", "victory"], "selective": true, "enabled": true,
      "content": "赢了！俺最横！下次找个更横的打！",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "grimgor", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["karl_franz", "defeat"], "selective": true, "enabled": true,
      "content": "败了。帝国输得起一场仗，输不起士气——收拢，重整，再来。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "karl_franz", "channel": "dilemma", "cond": { "result": "defeat" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["katarin", "victory"], "selective": true, "enabled": true,
      "content": "雪会盖住战场。基斯里夫的冬天，从来不问胜负——只问谁还活着。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "katarin", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["queek", "victory"], "selective": true, "enabled": true,
      "content": "头收满了，yes-yes！这一仗的头，值得上最好的架子！",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "queek", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["settra", "victory"], "selective": true, "enabled": true,
      "content": "胜。此乃理所当然——朕从不打必输之仗。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "settra", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["greasus", "victory"], "selective": true, "enabled": true,
      "content": "打赢了。清点战利品——能吃的下锅，能卖的上秤。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "greasus", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["archaon", "victory"], "selective": true, "enabled": true,
      "content": "终结又近了一步。这一场只是序页。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "archaon", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["tyrion", "victory"], "selective": true, "enabled": true,
      "content": "赢了。埋葬死者，擦拭武器——奥苏安还站在这里。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "tyrion", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["mannfred", "victory"], "selective": true, "enabled": true,
      "content": "他们的阵亡名册，是我军的花名册。今日兵源又充盈了几分。",
      "insertion_order": 75, "priority": 85,
      "extensions": { "czx": { "kind": "line", "speaker": "mannfred", "channel": "dilemma", "cond": { "result": "victory" } } }
    },
    {
      "keys": ["battle_result"], "secondary_keys": ["draw"], "selective": true, "enabled": true,
      "content": "不分胜负。两败俱伤也是一种结果——只是没人愿意承认。",
      "insertion_order": 80, "priority": 55,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "dilemma", "cond": { "result": "draw" } } }
    }
  ]
}
