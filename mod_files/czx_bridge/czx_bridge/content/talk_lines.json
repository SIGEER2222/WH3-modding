    {
      "keys": ["mass_rout"], "secondary_keys": ["enemy"], "selective": true, "enabled": true,
      "content": "他们开始跑了。追——但别追进埋伏里。",
      "insertion_order": 90, "priority": 60,
      "extensions": { "czx": { "kind": "line", "speaker": "narrator", "channel": "battle_bark", "cond": { "side": "enemy" } } }
