# User-maintained art source assets.
assets/

# User-maintained Blender manual-editing workspace (.blend binaries, large).
manual_edit/

# Read-only reference data and local tools.
bilingual/
gamedata/
rpfm*/
tools/AssetEditor/

# Local junction/symlink to the wyccc mod manager repo
# (no trailing slash: it is a junction/symlink, not a real directory).
wyccc-warhammer-mod-manager

# Generated packaging and release outputs.
mod_output/
workshop_release/

# Temporary / experimental scratch space.
# Put one-off scripts, dumps, screenshots, and unrelated local changes here.
# Files in this directory are intentionally not tracked.
scratch/
__pycache__/
*.pack.bak

# Tools-only output / downloaded / binary / test / intermediate directories.
# Any tools/_<name>/ directory is a non-tracked working dir by convention.
tools/_*/
tools/qtrme/
*.glb

# Root-level hygiene backstop: temp/junk must live under scratch/, not the
# repo root. These patterns keep `git status` clean if something is still
# created at the top level by mistake.
/_tmp_*
/_preview/
/_work_*/
